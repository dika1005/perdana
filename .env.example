# ==============================================================================
# CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES TEMPLATE)
# ==============================================================================
# Petunjuk:
# 1. Salin file ini menjadi `.env` (`cp .env.example .env`)
# 2. Isi nilai yang sesuai dengan environment Anda (Development / Production).
# 3. JANGAN PERNAH mencantumkan credential / secret asli ke dalam repository git.
# ==============================================================================

# Koneksi database MySQL / MariaDB
DATABASE_URL=mysql://db_user:db_password@localhost:3306/perdana

# Server binding
SERVER_HOST=127.0.0.1
SERVER_PORT=8800

# Level logging Rust (error, warn, info, debug, trace)
RUST_LOG=info

# Frontend origin URL untuk CORS
FRONTEND_ORIGIN=http://localhost:3000

# Secret untuk sign JWT Token (Wajib diubah! Minimal 32 karakter acak)
JWT_SECRET=isi_dengan_string_random_yang_panjang_dan_aman_minimal_32_karakter
JWT_ACCESS_TTL_SECS=28800
JWT_REFRESH_TTL_SECS=604800

# Kredensial akun Super Admin default saat inisialisasi pertama (Wajib diganti!)
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=password_superadmin_yang_sangat_kuat

# Konfigurasi container MariaDB (jika menjalankan database via docker-compose)
MARIADB_DATABASE=perdana
MARIADB_USER=db_user
MARIADB_PASSWORD=db_password
MARIADB_ROOT_PASSWORD=root_password_yang_aman
MARIADB_PORT=3306

# Informasi Toko / Percetakan untuk KOP Struk & Faktur Invoice
STORE_NAME="NAMA PERCETAKAN ANDA"
STORE_ADDRESS="Jl. Contoh Alamat No. 123, Kota"
STORE_PHONE="0812-3456-7890"

# Integrasi Google AI Studio / Gemini API (Opsional: biarkan kosong bila belum digunakan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
